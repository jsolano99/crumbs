# Copy this file to .env.local and fill in real values.

# OpenAI API key — powers the breakdown itself.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Upstash Redis (via the Vercel Marketplace "Upstash" integration, or directly
# at https://console.upstash.com) — backs accounts, sessions, and the free-try
# / rate-limit counters. Without these set, the app still runs, but there is
# no persistence: everyone gets unlimited free tries and "accounts" can't be
# created.
#
# The Vercel Upstash integration typically injects KV_REST_API_URL /
# KV_REST_API_TOKEN; a direct Upstash database uses UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN. Either naming works — set whichever one your
# provider gave you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
